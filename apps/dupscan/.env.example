# Copy to .env next to docker-compose.yml and adjust.

# Image tag to run: latest, or a sha-<commit> tag to pin a version and roll back.
IMAGE_TAG=latest

# NAS user and group the scan runs as. Run `id <user>` over SSH to read them.
# 1026:100 is the first account created on a DSM install, in the "users" group.
PUID=1026
PGID=100

# Folder to scan, mounted read-only.
PHOTOS_DIR=/volume1/photo

# Writable folder for the index and the reports. It must be writable by PUID:PGID.
DATA_DIR=/volume1/docker/dupscan

# Memory cap for the container. The JVM uses up to 75% of it.
MEM_LIMIT=2g
