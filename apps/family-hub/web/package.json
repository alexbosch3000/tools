{
  "name": "family-hub-web",
  "version": "0.1.0",
  "private": true,
  "description": "User interface of family-hub: served by the service, or from GitHub Pages against a remote server.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "npm run gen:api",
    "gen:api": "openapi-typescript src/api/openapi.json --output src/api/schema.d.ts",
    "dev": "vite",
    "build": "npm run gen:api && tsc --noEmit && vite build",
    "typecheck": "npm run gen:api && tsc --noEmit",
    "lint": "npm run typecheck && eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
