          "legendFormat": "process"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database connections",
      "description": "A single SQLite connection: requests queue for it instead of failing on SQLITE_BUSY.",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "fieldConfig": {
