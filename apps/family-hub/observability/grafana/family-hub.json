    },
    {
      "type": "bargauge",
      "title": "Spent per kind of shop (range)",
      "description": "Amounts entered when completing shopping lists, split by store type (groceries, clothing, DIY...).",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "color": {
            "mode": "fixed",
            "fixedColor": "#2a78d6"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (store_type) (increase(familyhub_shopping_spent_euros_sum{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{store_type}}",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Planning entries created (range)",
      "description": "",
      "id": 11,
      "datasource": {
