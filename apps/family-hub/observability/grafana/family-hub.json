      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(familyhub_shopping_trips_total{job=~\"$job\"}[$__range]))"
        }
