# Copy to .env next to docker-compose.yml and adjust. No secret goes here.

# Image tag to run: latest follows main; sha-<full commit sha> freezes a version.
IMAGE_TAG=latest

# Port published on the NAS (8080 is used by my-todo-list).
HOST_PORT=8081

# NAS account owning DATA_DIR: run `id <your-dsm-user>` over SSH.
PUID=1026
PGID=100

# Folder holding the SQLite database. Create it and chown it to PUID:PGID first.
DATA_DIR=/volume1/docker/family-hub/data

# Time zone of the family: every date and time of the planning is local to it.
APP_TIME_ZONE=Europe/Paris

# Web pages allowed to call the API from another origin, comma-separated. Keep this value to use
# the interface published on GitHub Pages (the service must then be reached over HTTPS); leave
# empty to use only the interface served by the NAS itself.
APP_ALLOWED_ORIGINS=https://alexbosch3000.github.io

# OpenTelemetry collector receiving traces, logs and metrics over OTLP/HTTP, for example
# http://<collector>:4318. Leave empty to export nothing; /actuator/prometheus still answers.
OTEL_EXPORTER_OTLP_ENDPOINT=

MEM_LIMIT=512m
